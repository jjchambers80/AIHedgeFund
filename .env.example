# ─────────────────────────────────────────────────────────────────────────────
# ARF-OS environment variables
# Copy to .env and fill in values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────

# Node environment. Use "development" locally; "production" in deployed envs.
NODE_ENV=development

# ── API server ────────────────────────────────────────────────────────────────

# TCP port the Fastify API listens on.
PORT=3001

# Bind address. Use 0.0.0.0 in containers, 127.0.0.1 for local-only.
HOST=0.0.0.0

# Minimum log level (trace | debug | info | warn | error | fatal).
LOG_LEVEL=info

# Allowed CORS origin for the web app. Comma-separate multiple origins if needed.
CORS_ORIGIN=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Drizzle ORM and postgres-js both read this.
DATABASE_URL=postgres://arfos:arfos@localhost:5432/arfos

# ── Redis / BullMQ ────────────────────────────────────────────────────────────

# Redis URL used by BullMQ workers and queues.
REDIS_URL=redis://localhost:6379

# ── Auth (stub mode) ──────────────────────────────────────────────────────────
# Set STUB_AUTH=true for local development. Production will use Clerk.
# WARNING: never set STUB_AUTH=true in a deployed environment.

# Enables stub auth on the API server. Reads X-Stub-* request headers.
STUB_AUTH=true

# Fallback user/org identity when X-Stub-* headers are absent (server-side).
STUB_USER_ID=user_dev
STUB_ORG_ID=org_dev

# ── Object storage (Cloudflare R2) ────────────────────────────────────────────
# Production: Cloudflare R2.
# Dev alternative: MinIO — set R2_ACCOUNT_ID to any placeholder string and
#   point the SDK at your MinIO endpoint by overriding getS3Client() locally.
# MinIO quick-start defaults:
#   R2_ACCOUNT_ID=minioadmin
#   R2_ACCESS_KEY_ID=minioadmin
#   R2_SECRET_ACCESS_KEY=minioadmin
#   R2_BUCKET=arfos-dev

# Cloudflare account ID — used to construct the R2 endpoint URL.
R2_ACCOUNT_ID=your_cloudflare_account_id

# R2 / MinIO access key ID.
R2_ACCESS_KEY_ID=your_r2_access_key_id

# R2 / MinIO secret access key.
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Bucket name for strategy artefacts, CSV uploads, and backtest outputs.
R2_BUCKET=arfos-dev

# Public base URL for the bucket (optional — used for download links if set).
R2_PUBLIC_URL=https://your-bucket.your-account.r2.cloudflarestorage.com

# ── Web app (Next.js / NEXT_PUBLIC_*) ─────────────────────────────────────────
# These vars are baked into the browser bundle at Next.js build time.

# Base URL for the Fastify API, reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Enables stub auth header injection in the web API client.
# Must match STUB_AUTH on the API side.
NEXT_PUBLIC_STUB_AUTH=true

# Stub identity injected into X-Stub-* request headers from the browser.
NEXT_PUBLIC_STUB_USER_ID=user_dev
NEXT_PUBLIC_STUB_ORG_ID=org_dev
NEXT_PUBLIC_STUB_ROLE=ADMIN

# ── Agent runtime ─────────────────────────────────────────────────────────────

# Set true to skip real model calls in development (uses stub provider).
AGENT_STUB=true

# Uncomment and populate when wiring real model providers.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Observability ─────────────────────────────────────────────────────────────

# OpenTelemetry collector endpoint. Uncomment to enable trace export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
