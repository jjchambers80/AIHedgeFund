{
  "name": "arf-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter @arf-os/db db:generate",
    "db:migrate": "pnpm --filter @arf-os/db db:migrate",
    "db:seed": "pnpm --filter @arf-os/db db:seed"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.7.0"
}
